  url = {https://journals.lww.com/jaaos/fulltext/2018/05150/osteoimmunology__effects_of_standard_orthopaedic.2.aspx?casa_token=9PyX2fcQps0AAAAA:PLWsffxxrWQvcgGKdW5b6PDMLLUqddBHoOMLEXkC_h-Lg6ZFhfW9gjQPky-oDIsTACyy1K1-cufiKHns5-4},
  urldate = {2022-10-20},
  abstract = {Achieving fracture union is highly dependent on the initial inflammatory phase of fracture healing, which is influenced by both the local and systemic inflammatory environments. The rapidly emerging field of osteoimmunology involves the study of the interactions between the immune system and the skeletal system. Recent research has advanced the current state of knowledge regarding the effects of the surrounding soft-tissue injury, fracture hematoma, and the method of fracture fixation on the inflammatory phase of fracture healing. Acute systemic inflammation, as seen in patients with polytrauma, and chronic systemic inflammation, as seen in patients with diabetes or rheumatoid arthritis, affects the inflammatory phase of fracture healing. The use of NSAIDs can influence early fracture healing. Understanding the effects of standard orthopaedic interventions on the local and systemic inflammatory responses and early fracture healing is important for optimizing fracture union.},
  langid = {american},
  file = {C:\Users\aaron\Zotero\storage\9DR2LHYR\osteoimmunology__effects_of_standard_orthopaedic.2.html}
}

@article{schubertEllipseAreaCalculations2014,
  title = {Ellipse Area Calculations and Their Applicability in Posturography},
  author = {Schubert, Patric and Kirchner, Marietta},
  date = {2014-01-01},
  journaltitle = {Gait \& Posture},
  shortjournal = {Gait \& Posture},
  volume = {39},
  number = {1},
