  abstract = {Recent advances in computer vision – a subfield of artificial intelligence – have led to ‘pose estimation’ algorithms capable of automated human movement tracking in both two and three dimensions using only video recordings. These video-based pose estimation technologies automatically identify and track anatomical landmarks throughout the body from videos recorded using a variety of devices, spanning simple household devices like smartphones or tablets to well-calibrated, commercially available markerless motion capture systems. In this chapter, we will cover the applications of these technologies for human gait and balance analyses in detail. We will introduce the reader to the basics of human pose estimation, discuss currently available approaches to using these technologies for analyses of gait and balance, briefly review recent work that has used video-based pose estimation to perform these analyses, and finally provide an overview of existing barriers and limitations. We will highlight the significant potential for leveraging video-based pose estimation technologies to greatly expand access to quantitative, objective, and accurate human movement. It is also important to emphasise that many of these technologies are freely available, further supporting the notion of significantly improved accessibility to tools for quantitative gait and balance analysis. After reading this chapter, it is our goal that the reader will come away with an introductory understanding about human pose estimation techniques and how they can be applied for human gait and balance analysis in virtually any setting.},
  isbn = {978-0-443-21484-4},
  keywords = {artificial intelligence,balance,biomechanics,computer science,Computer vision,gait,kinematics,machine learning,motor assessment,neural networks,pose estimation,review},
  file = {C\:\\Users\\aaron\\Zotero\\storage\\SCDUGGP6\\Stenum et al. - 2025 - Chapter 9 - Modern video-based gait and balance analysis.pdf;C\:\\Users\\aaron\\Zotero\\storage\\L636TIRG\\B9780443214844000090.html}
}

