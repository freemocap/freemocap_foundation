  keywords = {Computational modeling,Computing methodologies—Artificial intelligence—Computer vision—3D imaging,Computing methodologies—Artificial intelligence—Computer vision—Motion capture,Conferences,Predictive models,Solid modeling,Three-dimensional displays,Uncertainty,Virtual reality},
