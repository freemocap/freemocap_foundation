@article{vogelaarSciaticNerveRegeneration2004,
  title = {Sciatic Nerve Regeneration in Mice and Rats: Recovery of Sensory Innervation Is Followed by a Slowly Retreating Neuropathic Pain-like Syndrome},
  shorttitle = {Sciatic Nerve Regeneration in Mice and Rats},
  author = {Vogelaar, Christina F. and Vrinten, Dorien H. and Hoekman, Marco F. M. and Brakkee, Jan H. and Burbach, J. Peter H. and Hamers, Frank P. T.},
  date = {2004-11-19},
  journaltitle = {Brain Research},
  shortjournal = {Brain Research},
  volume = {1027},
