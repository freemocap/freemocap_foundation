@article{huangComparisonKinematicsJoint2024,
  title = {Comparison of Kinematics and Joint Moments Calculations for Lower Limbs during Gait Using Markerless and Marker-Based Motion Capture},
  author = {Huang, Tianchen and Ruan, Mianfang and Huang, Shangjun and Fan, Linlin and Wu, Xie},
