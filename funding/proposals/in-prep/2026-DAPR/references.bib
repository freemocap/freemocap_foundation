}

@article{maclachlanOBSERVERRATINGTHREEDIMENSIONAL2015,
  title = {{{OBSERVER RATING VERSUS THREE}}‐{{DIMENSIONAL MOTION ANALYSIS OF LOWER EXTREMITY KINEMATICS DURING FUNCTIONAL SCREENING TESTS}}: {{A SYSTEMATIC REVIEW}}},
  shorttitle = {{{OBSERVER RATING VERSUS THREE}}‐{{DIMENSIONAL MOTION ANALYSIS OF LOWER EXTREMITY KINEMATICS DURING FUNCTIONAL SCREENING TESTS}}},
