@article{marquisIndependentPredictorsCognitive2002,
  title = {Independent {{Predictors}} of {{Cognitive Decline}} in {{Healthy Elderly Persons}}},
  author = {Marquis, Scott and Moore, M. Milar and Howieson, Diane B. and Sexton, Gary and Payami, Haydeh and Kaye, Jeffrey A. and Camicioli, Richard},
  date = {2002-04-01},
  journaltitle = {Archives of Neurology},
  shortjournal = {Arch Neurol},
