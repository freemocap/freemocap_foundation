@dataset{cherianFreeMoCapValidationDataset2026,
  title = {{{FreeMoCap Validation Dataset}}: {{Multi-Camera Markerless Motion Capture}} of {{Treadmill Gait}} and {{Standing Balance}}},
  shorttitle = {{{FreeMoCap Validation Dataset}}},
  author = {Cherian, Aaron},
  date = {2026-09-29},
  publisher = {Zenodo},
  doi = {10.5281/zenodo.23041223},
  url = {https://zenodo.org/records/23041223},
  urldate = {2026-10-15},
  abstract = {This dataset contains the de-identified motion-capture data used to validate FreeMoCap, a free and open-source multi-camera markerless motion-capture system, during treadmill gait and standing balance tasks. Data were collected from six participants using synchronized low-cost cameras and a marker-based Qualisys motion-capture system as a reference. Markerless 3D trajectories are provided for three pose-estimation backends—MediaPipe, RTMPose, and ViTPose—alongside the corresponding marker-based reference data.The dataset includes treadmill gait trials spanning multiple walking speeds and modified Clinical Test of Sensory Interaction on Balance (CTSIB-M) conditions manipulating visual input and support surface. It is structured to support reproducible evaluation of markerless motion-capture performance, including joint kinematics, spatiotemporal gait measures, center-of-mass trajectories, and balance metrics. The accompanying FreeMoCap validation repository provides the analysis pipeline, trial configurations, and scripts used to reproduce the results, figures, and tables reported in the associated validation study.},
  keywords = {balance,biomechanics,FreeMoCap,gait,markerless motion capture,pose estimation},
  file = {C:\Users\aaron\Zotero\storage\HDEC34F6\23041223.html}
}

@article{cherianOpensourceDevelopmentValidation2026,
  title = {Open-Source Development and Validation of a Low-Cost Markerless System for Quantitative Motion Analysis},
  author = {Cherian, Aaron T.},
  date = {2026},
  url = {https://repository.library.northeastern.edu/files/neu:ms425z58z},
  urldate = {2026-10-15},
  abstract = {Marker-based motion capture is widely considered the gold standard for measuring human movement, providing precise three-dimensional kinematic data for research and clinical applications. However, these systems are expensive, require specialized environments and expertise, and are often inaccessible outside of well-resourced laboratories. As a result, there remains a need for methods that can provide meaningful movement data while expanding accessibility and enabling data collection in a wider range of contexts. This work presents the development and evaluation of a low-cost, open-source, multi-camera markerless motion capture system (FreeMoCap) designed to address these limitations. The system leverages consumer-grade cameras, a modular software architecture, and interchangeable pose estimation backends to provide a flexible and scalable framework for motion analysis. System performance was evaluated across four domains: (1) accuracy during treadmill gait at increasing speeds; (2) sensitivity to subtle postural shifts during a static balance assessment; (3) accuracy and sensitivity to gait changes resulting from controlled prosthesis alignment adjustments in a transfemoral prosthesis user; (4) comparative evaluation of multiple pose estimation trackers (MediaPipe, RTMPose, and ViTPose), including the training and integration of a custom DeepLabCut model for prosthetic tracking. Across these domains, markerless measurements demonstrated strong agreement with a marker-based reference for joint kinematics and spatiotemporal parameters. Markerless center of mass metrics were sensitive to condition-dependent changes in balance, and the integration of a custom-trained DeepLabCut model substantially improved tracking accuracy for prosthetic limb motion and sensitivity to alignment changes. These findings demonstrate that low-cost markerless motion capture can provide accurate and sensitive kinematic measurements across multiple movement contexts, while highlighting that system performance is shaped by factors such as pose estimation algorithm choice and task-specific demands. Ultimately, markerless motion capture should not be viewed as a replacement for marker-based systems, but as an expansion of where, how, and by whom movement can be measured.--Author's abstract},
  file = {C:\Users\aaron\Zotero\storage\UV6JKAC9\Cherian - 2026 - Open-source development and validation of a low-cost markerless system for quantitative motion analy.pdf}
}

@article{choRelationshipPosturalSway2014,
  title = {Relationship between {{Postural Sway}} and {{Dynamic Balance}} in {{Stroke Patients}}},
  author = {Cho, Kihun and Lee, Kyoungsuk and Lee, Byungjoon and Lee, Hwangjae and Lee, Wanhee},
  date = {2014-12},
  journaltitle = {Journal of Physical Therapy Science},
  shortjournal = {J Phys Ther Sci},
  volume = {26},
  number = {12},
  eprint = {25540514},
  eprinttype = {pubmed},
  pages = {1989--1992},
  issn = {0915-5287},
  doi = {10.1589/jpts.26.1989},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4273074/},
  urldate = {2022-10-06},
  abstract = {[Purpose] The purpose of the current study was to investigate the relationship between postural sway and dynamic balance in post stroke patients. [Subjects] Thirty-one stroke patients (20 men and 11 women; age 64.25\>years; stroke duration 12.70 months; MMSE-K score 26.35) participated in this study. [Methods] This study applied a cross-sectional design. A Good Balance system was used for measurement of the postural sway velocity (anteroposterior and mediolateral) and velocity moment of subjects under the eyes open and eyes closed conditions in a standing posture. The postural sway of subjects was measured under two surface conditions (stable and unstable surfaces). [Results] On the unstable surface (foam), no significant correlation was observed between postural sway and dynamic balance except for the berg balance scale (BBS) score and anteroposterior postural sway velocity under the eyes open condition, anteroposterior postural sway velocity under the eyes closed condition, and postural sway velocity moment. In addition, in the stable condition, no significant correlation was observed between postural sway and dynamic balance. [Conclusion] Our results indicate that a decrease in postural sway does not necessarily reflect improvement of dynamic balance ability. We believe that this finding may be useful in balance rehabilitation for prevention of falls after a stroke.},
  pmcid = {PMC4273074},
  file = {C:\Users\aaron\Zotero\storage\PQGW2NLK\Cho et al. - 2014 - Relationship between Postural Sway and Dynamic Bal.pdf}
}

