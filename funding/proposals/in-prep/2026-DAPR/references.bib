  title = {Assessing Gait and Balance Impairment in Elderly Residents of Nursing Homes},
  author = {Borowicz, Adrianna and Zasadzka, Ewa and Gaczkowska, Agnieszka and Gawłowska, Olga and Pawlaczyk, Mariola},
