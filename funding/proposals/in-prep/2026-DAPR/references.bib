  title = {A Comparison of Accelerometry and Center of Pressure Measures during Computerized Dynamic Posturography: {{A}} Measure of Balance},
  shorttitle = {A Comparison of Accelerometry and Center of Pressure Measures during Computerized Dynamic Posturography},
  author = {Whitney, S.L. and Roche, J.L. and Marchetti, G.F. and Lin, C.-C. and Steed, D.P. and Furman, G.R. and Musolino, M.C. and Redfern, M.S.},
