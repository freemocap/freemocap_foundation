@article{koolenCapturabilitybasedAnalysisControl2012,
  title = {Capturability-Based Analysis and Control of Legged Locomotion, {{Part}} 1: {{Theory}} and Application to Three Simple Gait Models},
  shorttitle = {Capturability-Based Analysis and Control of Legged Locomotion, {{Part}} 1},
  author = {Koolen, Twan and family=Boer, given=Tomas, prefix=de, useprefix=true and Rebula, John and Goswami, Ambarish and Pratt, Jerry},
