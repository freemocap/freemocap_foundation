  author = {Hughes, M. A. and Weiner, D. K. and Schenkman, M. L. and Long, R. M. and Studenski, S. A.},
  date = {1994-05-01},
  journaltitle = {Clinical Biomechanics},
  shortjournal = {Clinical Biomechanics},
  volume = {9},
  number = {3},
  pages = {187--192},
  issn = {0268-0033},
  doi = {10.1016/0268-0033(94)90020-5},
  url = {https://www.sciencedirect.com/science/article/pii/0268003394900205},
  urldate = {2023-10-02},
  abstract = {The elderly often have difficulty with rising from a chair. The purpose of this study was to characterize their rising strategies. A group of 22 elderly adults with a range of functional impairments was asked to rise from chairs of varying heights. Videotape motion analysis was used to identify strategies, estimate centre of mass, and measure time to rise. Three movement strategies were identified, “momentum transfer”, “stabilization”, and “combined” based on the velocity of trunk movement and base of support rearrangement. “Momentum transfer” uses horizontal momentum developed in the trunk to rise; “stabilization” uses centre of mass and base of support repositioning but very little momentum; “combined” uses elements of both momentum transfer and stabilization. Differences in the time to rise and the centre of mass to base of support separation between the momentum transfer and stabilization strategies were significant at each chair height. The momentum transfer, combined, and stabilization may form a continuum of chair rise strategies.},
  keywords = {activities of daily living,biomechanics,kinesiology,Sit to stand},
  file = {C:\Users\aaron\Zotero\storage\GET2Q2HZ\0268003394900205.html}
}

