  title = {Gait {{Dysfunction}} in {{Mild Cognitive Impairment Syndromes}}},
  author = {Verghese, Joe and Robbins, Matthew and Holtzer, Roee and Zimmerman, Molly and Wang, Cuiling and Xue, Xiaonan and Lipton, Richard B.},
  date = {2008-07},
  journaltitle = {Journal of the American Geriatrics Society},
