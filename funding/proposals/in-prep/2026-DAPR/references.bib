  shorttitle = {Ankle Osteoarthritis},
  author = {Herrera-Pérez, Mario and Valderrabano, Victor and Godoy-Santos, Alexandre L and family=César Netto, given=César, prefix=de, useprefix=true and González-Martín, David and Tejero, Sergio},
