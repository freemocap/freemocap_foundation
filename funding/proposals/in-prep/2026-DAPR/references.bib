@article{bellPredictionHipJoint1989,
  title = {Prediction of Hip Joint Centre Location from External Landmarks},
  author = {Bell, Alexander L. and Brand, Richard A. and Pedersen, Douglas R.},
  date = {1989-02-01},
  journaltitle = {Human Movement Science},
  shortjournal = {Human Movement Science},
  volume = {8},
  number = {1},
  pages = {3--16},
  issn = {0167-9457},
  doi = {10.1016/0167-9457(89)90020-1},
  url = {https://www.sciencedirect.com/science/article/pii/0167945789900201},
  urldate = {2026-03-04},
  abstract = {The approaches to predicting the hip joint centre (HJC) location of Tylkowski's group and Andriacchi's group were evaluated for accuracy and validity in children and adults of both sexes. Using Tylkowski's approach, we found that the three-dimensional (3-D) HJC location in adults (expressed as a percentage of the distance between the anterior superior iliac spines (ASIS)) was 30\% distal, 14\% medial, and 22\% posterior to the ASIS, and predicted the HJC location to within 3.3 cm of the true location with 95\% certainty. Using Andriacchi's approach, we found that the HJC was located in the frontal plane distal and lateral to the midpoint of a line between the ASIS and pubic symphysis, and varied from 2.2 cm distal and 0.78 cm lateral in girls to 4.6 cm distal and 1.7 cm lateral in men. A more accurate method of estimating the 3-D HJC location combined a modification of Andriacchi's approach (estimating frontal plane location of HJC) with a modification of Tylkowski's approach (estimating HJC location posterior to a frontal plane), and could predict the HJC location in adults to within 2.6 cm of the true location with 95\% certainty.},
  file = {C\:\\Users\\aaron\\Zotero\\storage\\NTTGD3YN\\Bell et al. - 1989 - Prediction of hip joint centre location from external landmarks.pdf;C\:\\Users\\aaron\\Zotero\\storage\\XUE3EE2M\\0167945789900201.html}
}

