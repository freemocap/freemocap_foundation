@article{jancovavseteckovaWHATROLEBODY2013,
  title = {{{WHAT IS THE ROLE BODY SWAY DEVIATION AND BODY SWAY VELOCITY PLAY IN POSTURAL STABILITY IN OLDER ADULTS}}?},
  author = {Jančová Všetečková, Jitka and Drey, Nicholas},
  date = {2013},
  journaltitle = {Acta Medica (Hradec Kralove, Czech Republic)},
  shortjournal = {Acta Med. (Hradec Kralove, Czech Repub.)},
  volume = {56},
  number = {3},
  pages = {117--123},
  issn = {1211-4286, 1805-9694},
  doi = {10.14712/18059694.2014.19},
  url = {https://actamedica.lfhk.cuni.cz/56/3/0117/},
  urldate = {2026-03-25},
  abstract = {This cross sectional study focused on how Postural Stability (PS) indicators: body sway deviation (BSD) and body sway velocity (BSV), change with age and their association with levels of social and physical activity. Observational study: 80 older adults (aged: 60–96) were purposefully recruited from two sources: the University of the Third Age (TAU) (n = 35) and a residential care home (CH) (n = 45). Differences in the indicators of PS, approximated through Centre of Pressure (COP) measurements, were assessed by the Romberg Stance Test (Test A) subsequently repeated on 10 cm foam surface (Test B), using a Kistler® Dynamometric Platform. The RCH Group was older, had higher BMI and was less socially and physically active, showed more body sway in all indicators compared to TAU group. For all participants body sway velocity (BSV) was significantly correlated with age. The strength of correlation of body sway deviation (BSD) with age was also significant but not as strong. The findings indicate in line with previous studies that deterioration in BSV is associated with poor PS more than deterioration in BSD.},
  langid = {english},
  file = {C:\Users\aaron\Zotero\storage\HN6A9KX7\Jančová Všetečková and Drey - 2013 - WHAT IS THE ROLE BODY SWAY DEVIATION AND BODY SWAY VELOCITY PLAY IN POSTURAL STABILITY IN OLDER ADUL.pdf}
}

@article{jatesiktatAnatomicalMarkerDriven3DMarkerless2024,
  title = {Anatomical-{{Marker-Driven 3D Markerless Human Motion Capture}}},
  author = {Jatesiktat, Prayook and Lim, Guan Ming and Lim, Wee Sen and Ang, Wei Tech},
  date = {2024},
  journaltitle = {IEEE Journal of Biomedical and Health Informatics},
  pages = {1--14},
  issn = {2168-2208},
  doi = {10.1109/JBHI.2024.3424869},
  url = {https://ieeexplore.ieee.org/document/10591328/?arnumber=10591328},
  urldate = {2024-10-16},
  abstract = {Marker-based motion capture (mocap) is a conventional method used in biomechanics research to precisely analyze human movement. However, the time-consuming marker placement process and extensive post-processing limit its wider adoption. Therefore, markerless mocap systems that use deep learning to estimate 2D keypoint from images have emerged as a promising alternative, but annotation errors in training datasets used by deep learning models can affect estimation accuracy. To improve the precision of 2D keypoint annotation, we present a method that uses anatomical landmarks based on marker-based mocap. Specifically, we use multiple RGB cameras synchronized and calibrated with a marker-based mocap system to create a high-quality dataset (RRIS40) of images annotated with surface anatomical landmarks. A deep neural network is then trained to estimate these 2D anatomical landmarks and a ray-distance-based triangulation is used to calculate the 3D marker positions. We conducted extensive evaluations on our RRIS40 test set, which consists of 10 subjects performing various movements. Compared against a marker-based system, our method achieves a mean Euclidean error of 13.23 mm in 3D marker position, which is comparable to the precision of marker placement itself. By learning directly to predict anatomical keypoints from images, our method outperforms OpenCap's augmentation of 3D anatomical landmarks from triangulated wild keypoints. This highlights the potential of facilitating wider integration of markerless mocap into biomechanics research. The RRIS40 test set is made publicly available for research purposes at koonyook.github.io/rris40.},
  eventtitle = {{{IEEE Journal}} of {{Biomedical}} and {{Health Informatics}}},
  keywords = {Accuracy,Anatomical landmarks,biomechanics,Cameras,data collection,deep learning,Deep learning,Feature extraction,markerless motion capture,Motion capture,Solid modeling,Three-dimensional displays},
  file = {C\:\\Users\\aaron\\Zotero\\storage\\GTAV3VTD\\Jatesiktat et al. - 2024 - Anatomical-Marker-Driven 3D Markerless Human Motio.pdf;C\:\\Users\\aaron\\Zotero\\storage\\79HIW6UA\\10591328.html}
}

