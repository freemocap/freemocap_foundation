  shorttitle = {1 € Filter},
  booktitle = {Proceedings of the {{SIGCHI Conference}} on {{Human Factors}} in {{Computing Systems}}},
  author = {Casiez, Géry and Roussel, Nicolas and Vogel, Daniel},
  date = {2012-05-05},
