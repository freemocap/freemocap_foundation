@inproceedings{peechattMULTICOLLABMultimodalCorpus2024,
  title = {{{MULTICOLLAB}}: {{A Multimodal Corpus}} of {{Dialogues}} for {{Analyzing Collaboration}} and {{Frustration}} in {{Language}}},
  shorttitle = {{{MULTICOLLAB}}},
  booktitle = {Proceedings of the 2024 {{Joint International Conference}} on {{Computational Linguistics}}, {{Language Resources}} and {{Evaluation}} ({{LREC-COLING}} 2024)},
  author = {Peechatt, Michael and Alm, Cecilia Ovesdotter and Bailey, Reynold},
