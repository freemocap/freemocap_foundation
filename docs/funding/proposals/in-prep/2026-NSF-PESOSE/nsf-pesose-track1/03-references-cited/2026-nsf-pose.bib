}

@inproceedings{orrMULTICOLLABASLAffectiveComputing2024,
  title = {{{MULTICOLLAB-ASL}}: {{Towards Affective Computing}} for the {{Deaf Community}}},
  shorttitle = {{{MULTICOLLAB-ASL}}},
  booktitle = {Proceedings of the 26th {{International ACM SIGACCESS Conference}} on {{Computers}} and {{Accessibility}}},
