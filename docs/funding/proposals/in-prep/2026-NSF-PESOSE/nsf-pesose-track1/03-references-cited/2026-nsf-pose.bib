@article{cherianOpensourceDevelopmentValidation2026,
  title = {Open-Source Development and Validation of a Low-Cost Markerless System for Quantitative Motion Analysis},
  author = {Cherian, Aaron T.},
  year = 2026,
  urldate = {2026-08-26},
  abstract = {Marker-based motion capture is widely considered the gold standard for measuring human movement, providing precise three-dimensional kinematic data for research and clinical applications. However, these systems are expensive, require specialized environments and expertise, and are often inaccessible outside of well-resourced laboratories. As a result, there remains a need for methods that can provide meaningful movement data while expanding accessibility and enabling data collection in a wider range of contexts. This work presents the development and evaluation of a low-cost, open-source, multi-camera markerless motion capture system (FreeMoCap) designed to address these limitations. The system leverages consumer-grade cameras, a modular software architecture, and interchangeable pose estimation backends to provide a flexible and scalable framework for motion analysis. System performance was evaluated across four domains: (1) accuracy during treadmill gait at increasing speeds; (2) sensitivity to subtle postural shifts during a static balance assessment; (3) accuracy and sensitivity to gait changes resulting from controlled prosthesis alignment adjustments in a transfemoral prosthesis user; (4) comparative evaluation of multiple pose estimation trackers (MediaPipe, RTMPose, and ViTPose), including the training and integration of a custom DeepLabCut model for prosthetic tracking. Across these domains, markerless measurements demonstrated strong agreement with a marker-based reference for joint kinematics and spatiotemporal parameters. Markerless center of mass metrics were sensitive to condition-dependent changes in balance, and the integration of a custom-trained DeepLabCut model substantially improved tracking accuracy for prosthetic limb motion and sensitivity to alignment changes. These findings demonstrate that low-cost markerless motion capture can provide accurate and sensitive kinematic measurements across multiple movement contexts, while highlighting that system performance is shaped by factors such as pose estimation algorithm choice and task-specific demands. Ultimately, markerless motion capture should not be viewed as a replacement for marker-based systems, but as an expansion of where, how, and by whom movement can be measured.--Author's abstract},
  file = {C:\Users\aaron\Zotero\storage\5PBF3UBB\Cherian - 2026 - Open-source development and validation of a low-cost markerless system for quantitative motion analy.pdf}
}

@misc{cimorelliPortableInclinicVideobased2022,
  title = {Portable In-Clinic Video-Based Gait Analysis: Validation Study on Prosthetic Users},
  shorttitle = {Portable In-Clinic Video-Based Gait Analysis},
  author = {Cimorelli, Anthony and Patel, Ankit and Karakostas, Tasos and Cotton, R. James},
  year = 2022,
  month = nov,
  pages = {2022.11.10.22282089},
  publisher = {medRxiv},
  doi = {10.1101/2022.11.10.22282089},
  urldate = {2023-03-06},
  abstract = {Despite the common focus of gait in rehabilitation, there are few tools that allow quantitatively characterizing gait in the clinic. We recently described an algorithm, trained on a large dataset from our clinical gait analysis laboratory, which produces accurate cycle-by-cycle estimates of spatiotemporal gait parameters including step timing and walking velocity. Here, we demonstrate this system generalizes well to clinical care with a validation study on prosthetic users seen in therapy and outpatient clinic. Specifically, estimated walking velocity was similar to annotated 10-meter walking velocities, and cadence and foot contact times closely mirrored our wearable sensor measurements. Additionally, we found that a 2D keypoint detector pre-trained on largely able-bodied individuals struggles to localize prosthetic joints, particularly for those individuals with more proximal or bilateral amputations, but it is possible to train a prosthetic-specific joint detector. Further work is required to validate the other outputs from our algorithm including sagittal plane joint angles and step length. Code and trained weights will be released upon publication.},
  archiveprefix = {medRxiv},
  copyright = {\copyright{} 2022, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution-NoDerivs 4.0 International), CC BY-ND 4.0, as described at http://creativecommons.org/licenses/by-nd/4.0/},
  langid = {english},
  file = {C:\Users\aaron\Zotero\storage\55MU8ERB\Cimorelli et al. - 2022 - Portable in-clinic video-based gait analysis vali.pdf}
}

@misc{cottonPosePipeOpenSourceHuman2022,
  title = {{{PosePipe}}: {{Open-Source Human Pose Estimation Pipeline}} for {{Clinical Research}}},
  shorttitle = {{{PosePipe}}},
  author = {Cotton, R. James},
  year = 2022,
  month = mar,
  number = {arXiv:2203.08792},
  eprint = {2203.08792},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2203.08792},
  urldate = {2026-03-25},
  abstract = {There has been significant progress in machine learning algorithms for human pose estimation that may provide immense value in rehabilitation and movement sciences. However, there remain several challenges to routine use of these tools for clinical practice and translational research, including: 1) high technical barrier to entry, 2) rapidly evolving space of algorithms, 3) challenging algorithmic interdependencies, and 4) complex data management requirements between these components. To mitigate these barriers, we developed a human pose estimation pipeline that facilitates running state-of-the-art algorithms on data acquired in clinical context. Our system allows for running different implementations of several classes of algorithms and handles their interdependencies easily. These algorithm classes include subject identification and tracking, 2D keypoint detection, 3D joint location estimation, and estimating the pose of body models. The system uses a database to manage videos, intermediate analyses, and data for computations at each stage. It also provides tools for data visualization, including generating video overlays that also obscure faces to enhance privacy. Our goal in this work is not to train new algorithms, but to advance the use of cutting-edge human pose estimation algorithms for clinical and translation research. We show that this tool facilitates analyzing large numbers of videos of human movement ranging from gait laboratories analyses, to clinic and therapy visits, to people in the community. We also highlight limitations of these algorithms when applied to clinical populations in a rehabilitation setting.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Computer Science - Software Engineering,Quantitative Biology - Quantitative Methods},
  file = {C\:\\Users\\aaron\\Zotero\\storage\\NC6WFDCS\\Cotton - 2022 - PosePipe Open-Source Human Pose Estimation Pipeline for Clinical Research.pdf;C\:\\Users\\aaron\\Zotero\\storage\\V3GQ2EFR\\2203.html}
}

@article{dariciLowcostMarkerlessMotion2026,
  title = {A Low-Cost Markerless Motion Capture System to Automate Functional Gait Assessment: {{Feasibility}} Study},
  shorttitle = {A Low-Cost Markerless Motion Capture System to Automate Functional Gait Assessment},
  author = {Darici, Osman and Cabak, Chanel and Wong, Jeremy D.},
  year = 2026,
  month = jun,
  journal = {PLOS ONE},
  volume = {21},
  number = {6},
  pages = {e0346606},
  publisher = {Public Library of Science},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0346606},
  urldate = {2026-08-26},
  abstract = {Functional gait assessments in older adults have traditionally required manual in-person quantification of clinical measures such as walking speed and step placement. This reliance on individuals trained in motion analysis hinders the frequency with which they are performed and reduces their generalizability and replicability. To standardize, simplify, and broaden access to gait assessments we here deploy recently-developed open-source tools to produce a low-cost, AI driven markerless motion capture system with custom analysis software for Functional Gait Assessment. Our system uses 3 Cameras and was validated with a traditional marker-based system on subjects (N = 3), showing strong correlation to laboratory-standard measures of step length (R2 = 0.98), step width (R2 = 0.97), and head speed (R2 = 0.95). The markerless system's FGA reports demonstrated data similar to previous FGA findings in older adult subjects (N = 5). Moreover, supplemental standard biomechanical gait measures Step Width, walking Duration, and continuous Gait Speed may be integrated to augment existing FGA. This study demonstrates a proof-of-principle open-source markerless system for analyses of functional gait.},
  langid = {english},
  keywords = {Cameras,Computer software,Computer vision,Elderly,Gait analysis,Medical risk factors,Open source software,Walking},
  file = {C:\Users\aaron\Zotero\storage\DBR5CMDS\Darici et al. - 2026 - A low-cost markerless motion capture system to automate functional gait assessment Feasibility stud.pdf}
}

