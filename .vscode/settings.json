{
    "gitdoc.enabled": true,
    "spellright.language": [
        "en"
    ],
    "spellright.documentTypes": [
        "markdown",
        "latex",
        "plaintext",
        "typst"
    ],
    "spellright.parserByClass": {
        "typst": {
            "parser": "plain"
        }
    },
    "gitdoc.commitValidationLevel": "none",
    "gitdoc.noVerify": true
}